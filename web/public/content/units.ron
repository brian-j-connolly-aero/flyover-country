// Aircraft roles and faction uniques. Must stay in UnitKind order.
// speed: tenths of a map unit per game minute. fuel_rate: Fuel per 1000 map units.
// strike/air: per-plane hit chances in per mille. air is vs (Fighter, Bomber, Scout, Jammer, Drone).
[
    UnitDef(
        kind: Fighter, name: "Fighters", faction: None, class: Fighter,
        cost: 4, speed: 60, fuel_rate: 2, strike: 200,
        air: (280, 420, 150, 420, 380),
        orders: [Rest, Guard, Escort, Sweep, Attack, Rebase],
        desc: "Shoot down aircraft. Guard, escort or sweep; they can attack, but weakly.",
    ),
