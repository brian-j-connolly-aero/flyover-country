// California's Patch Notes: one rolls each dawn and applies to every Unicorn
// Swarm that night. Half buffs, half nerfs, all announced on the big screen.
[
    PatchNote(version: "v4.2", text: "Drones now avoid the ocean, mostly.", effect: Fuel(-1)),
    PatchNote(version: "v3.1.4", text: "Drones no longer salute enemy aircraft.", effect: Evasion(80)),
    PatchNote(version: "v4.3", text: "Targeting model retrained on vibes.", effect: Accuracy(-80)),
    PatchNote(version: "v4.3.1", text: "Rolled back the vibes.", effect: Accuracy(60)),
    PatchNote(version: "v5.0", text: "Major redesign. Drones are now rounder.", effect: Speed(-8)),
    PatchNote(version: "v5.0.1", text: "Drones are less round.", effect: Speed(6)),
    PatchNote(version: "v2.9", text: "Added dark mode. Drones are harder to see at night.", effect: Evasion(100)),
    PatchNote(version: "v3.3", text: "Drones now ask for feedback mid-mission.", effect: Speed(-6)),
    PatchNote(version: "v3.4", text: "Removed the feedback prompt. You're welcome.", effect: Speed(8)),
    PatchNote(version: "v6.0", text: "Drones migrated to a new framework. Some features may be missing.", effect: Accuracy(-100)),
    PatchNote(version: "v6.1", text: "Restored missing features, plus a few new ones.", effect: Accuracy(90)),
    PatchNote(version: "v4.4", text: "Battery life improved by moving the drones closer to the sun.", effect: Fuel(-1)),
    PatchNote(version: "v4.5", text: "Drones now render a loading spinner over their targets.", effect: Evasion(-80)),
    PatchNote(version: "v7.0", text: "Introducing Drones Pro. Same drones, new font.", effect: Accuracy(40)),
    PatchNote(version: "v7.0.2", text: "Fixed a bug where drones attacked their own shadows.", effect: Accuracy(70)),
    PatchNote(version: "v7.1", text: "Drones now require you to accept new terms of service before every mission.", effect: Speed(-10)),
    PatchNote(version: "v2.2", text: "Telemetry upload now happens during the attack run.", effect: Evasion(-60)),
    PatchNote(version: "v8.0", text: "Pivoted to sustainable flight. Drones glide whenever possible.", effect: Fuel(-2)),
    PatchNote(version: "v8.0.1", text: "Gliding was a mistake.", effect: Fuel(1)),
    PatchNote(version: "v1.0.0-final-FINAL", text: "Finally out of beta. Except for the parts still in beta.", effect: Accuracy(50)),
    PatchNote(version: "v3.7", text: "Drones now carry a small motivational sticker.", effect: Accuracy(30)),
    PatchNote(version: "v3.8", text: "The sticker was a choking hazard.", effect: Speed(-4)),
    PatchNote(version: "v9.0", text: "Every drone now has a personality. Some are shy.", effect: Evasion(60)),
    PatchNote(version: "v9.1", text: "Some drones are too confident.", effect: Evasion(-90)),
    PatchNote(version: "v4.0", text: "Brand refresh: drones now glow a tasteful coral.", effect: Evasion(-70)),
    PatchNote(version: "v4.0.1", text: "Turned the glow down.", effect: Evasion(50)),
    PatchNote(version: "v5.5", text: "Swarm logic now uses a group chat. Nobody reads it.", effect: Accuracy(-60)),
    PatchNote(version: "v5.6", text: "Group chat muted. Productivity up.", effect: Speed(8)),
    PatchNote(version: "v6.6.6", text: "Rewrote the flight controller in a weekend.", effect: Speed(12)),
    PatchNote(version: "v6.6.7", text: "Reverted the weekend.", effect: Accuracy(-40)),
]
