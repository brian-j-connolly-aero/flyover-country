    leaders: {
        "Pacific": LeaderDef(
            name: "Princess Donut",
            title: "Founder & Chief Princess Officer",
            bio: "A regal chocolate-and-tan founder in a very small tiara. Princess Donut ships fast, fixes nothing and expects a status update by sunrise.",
            pick: [
                "Princess Donut, live and in production. Let's disrupt the West.",
                "Per my last bark: we're winning this. Ship it.",
            ],
            dawn: [
                "Good morning, team. Quick sync: we win today. Okay, bye.",
                "New day, new patch. I haven't read the notes. Neither should you.",
                "Let's circle back on last night. Actually, let's not. Ship it.",
                "Reminder: my calendar is blocked for a nap from two to five. Win before then.",
                "Love the energy, everyone. Big learnings. Bigger drones.",
                "Good morning. I've already pivoted twice. Keep up, darlings.",
                "Today's OKR is winning. Stretch goal: winning harder. Okay, standup's over.",
                "Reminder: we dogfood our own drones here. I am, technically, the dog.",
