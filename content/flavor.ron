// Flyover Country: flavor text.
// Radio chatter, ace lines, dog-leader lines, advisor warnings, newspaper
// headlines and curtain filler. Loaded at startup; edit freely, no recompile.
//
// Tone check for every line: played straight, punch at places (never people),
// nobody dies on screen (planes "splash", pilots get a good chute), every
// faction lovable. The dog leaders are never in danger. Chatter stays short:
// under 70 characters where possible, never over 90.
//
// Griffin & Pan lines are mini-dialogues: "Speaker: text | Speaker: text".
//
// Placeholders
//   chatter:   {node} place name, {enemy} enemy faction short name, {zone} state name
//   advisor:   {unit} {count} {node} {nodes} {pct} {resource} {jewel} {reason}
//              ({reason} is a lowercase predicate, e.g. "crosses 2 air defense sites
//              with no jammer", so lines read "The route {reason}." or "It {reason}.")
//   headlines: {attacker} {victim} {node} {ace} {count} {zone}
//              Headlines are written in caps; uppercase the substituted names too.
FlavorDef(
    chatter: {
        // ------------------------------------------------------------------
        // Pacific Venture Republic (California): startup nation, ships fast.
        // ------------------------------------------------------------------
        "Pacific": {
            "launch": [
                "Wheels up. Let's ship it.",
                "Pacific flight is live in production.",
                "Off the deck. Burn rate's high, morale's higher.",
                "Departing the Bay. Fog's thick, vibes are good.",
                "Airborne. Smoother than the freeway, honestly.",
            ],
            "engage": [
                "{enemy} fighters, two o'clock. Let's disrupt them.",
                "Bandits inbound. Taking this meeting.",
                "Contact! {enemy} jets closing fast. Turning in.",
                "Hostiles over {zone}. Time to scale this up.",
                "Going hot. This is the part of the demo that works.",
            ],
            "splash": [
                "Splash one. That's a learning for them.",
                "Got him! Good chute. Disrupted.",
                "Splash! Somebody update the leaderboard.",
                "Target down. Closing that ticket.",
                "Splash one {enemy}. Tell the Princess we hit our numbers.",
            ],
            "flak": [
                "Flak! Heavy flak! This was not on the roadmap.",
                "Air defense is up. Jinking hard.",
                "Tracers everywhere. Love the energy, hate the bullets.",
                "Guns below! Pulling up into the marine layer.",
            ],
            "hit_taken": [
                "I'm hit! Still flying. Logging it as a known issue.",
                "Took a round in the wing. Patching it live.",
                "Damage on the left side. Still in beta, still flying.",
                "Hit, but stable. We ship with bugs.",
            ],
            "ejected": [
                "Punching out! Good chute. Great view of the coast.",
                "Four good chutes. We're sunsetting this squadron.",
                "Ejecting! Somebody save my seat at the standup.",
                "Squadron down. All chutes open. We'll pivot.",
                "Out of the jet and floating. Honestly? Kind of a vibe.",
            ],
            "strike": [
                "Bombs away on {node}. Shipped.",
                "Direct hit on {node}. Massive impact. Huge.",
                "{node} is disrupted. Repeat, disrupted.",
                "Payload delivered. Five stars, would bomb again.",
                "Strike on {node} complete. Adding it to the changelog.",
            ],
            "miss": [
                "Missed. Let's call it a learning.",
                "Bombs long. We'll iterate.",
                "Minimal impact. Calling it a soft launch.",
            ],
            "rtb": [
                "Heading home. Save us some fish tacos.",
                "Returning to base. Retro over burritos?",
                "Wrapping up. Back to the garage.",
            ],
            "capture": [
                "{node} is ours. Acquired, not merged.",
                "We hold {node}. Planting a flag and a coworking space.",
                "{node} captured. Rebranding it at dawn.",
            ],
            "jewel_strike": [
                "Hit on {node}! That's our whole quarter, right there.",
                "Crown jewel struck! Somebody screenshot that.",
                "{node} is burning. Disruption achieved.",
            ],
            "scout": [
                "Eyes on {zone}. Lots going on. Sending the deck.",
                "Scout here. {zone} is busier than the pitch said.",
                "Mapping {zone} the old way. No satellites. Wild.",
                "Recon done. Data's fresh, takes are hot.",
            ],
            "unique": [
                "Unicorn Swarm launched. They don't come back. That's the model.",
                "Drones away. Weak alone, scary at scale.",
                "Swarm on target. Each drone costs less than a Palo Alto lunch.",
                "Swarm inbound. All of them. At once. On purpose.",
                "One-way drones away. Tonight's patch says they mostly avoid the ocean.",
            ],
        },

        // ------------------------------------------------------------------
        // Cascadian Commonwealth (Washington, Oregon): rain, firs, process.
        // ------------------------------------------------------------------
        "Cascadia": {
            "launch": [
                "Cascade flight, wheels up. It's raining. Obviously.",
                "Lifting off. Visibility low. Concern also low.",
                "Off the runway. Wipers on, coffee in hand.",
                "Departing. Ceiling's at 200 feet. Feels like home.",
                "Airborne. Leaving the clouds only because we have to.",
            ],
            "engage": [
                "{enemy} fighters in our clouds. Rude.",
                "Contact, low. They came in through the overcast. Turning in.",
                "Bandits over {zone}. Time for some Northwest hospitality.",
                "Tally {enemy}. Sun-dried and overconfident.",
                "Engaging. Stay on the trail. The trail is behind them.",
            ],
            "splash": [
                "Splash one. Leave no trace. Well. Some trace.",
                "Splash! Good chute into the ferns.",
                "Got one. The next ferry will pick him up.",
                "Target down. That's what the rain is for.",
                "Splash one {enemy}. Wreckage goes in the recycling.",
            ],
            "flak": [
                "Flak! Can't see a thing. Hope they can't either.",
                "Tracers through the drizzle. Pressing on.",
                "Air defense is up. Dropping into the cloud deck.",
                "Heavy fire! Like a hailstorm, but personal.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Moss will grow over it.",
                "Took some damage. We're fine. Damp, but fine.",
                "Hit in the tail. Treating it like a slow leak.",
                "Damage taken. Still airworthy. Mostly.",
            ],
            "ejected": [
                "Ejecting! Good chute. Landing in the Douglas firs.",
                "We're out. Four chutes. It's raining up here too.",
                "Squadron down. Everyone's okay. Somebody bring towels.",
                "Punching out. Good chute. Beautiful hike back.",
                "Good chutes into the lake. Huckleberry's already swimming out.",
            ],
            "strike": [
                "Bombs on {node}. Under cloud cover, as nature intended.",
                "Direct hit on {node}. Filing a very thorough report.",
                "{node} hit. Sustainably.",
                "Payload delivered. Pack it in, pack it out.",
                "Strike on {node} confirmed. Heading back into the gray.",
            ],
            "miss": [
                "Missed. Too cloudy. Even for us.",
                "Bombs wide. We'll open a comment period on that.",
                "Light damage only. We'll be back. It'll still be raining.",
            ],
            "rtb": [
                "Heading home. Following the rain.",
                "Returning to base. Somebody put the kettle on.",
                "Back up the Gorge. Long night, good night.",
            ],
            "capture": [
                "{node} is ours. Planting a tree.",
                "We hold {node}. First order of business: recycling.",
                "{node} captured, after extensive community input.",
            ],
            "jewel_strike": [
                "Hit on {node}! Now that felt deeply satisfying.",
                "Crown jewel struck. That's for every sunny day you bragged about.",
                "{node} hit. Let's not gloat. Okay, one small gloat.",
            ],
            "scout": [
                "Eyes on {zone}. It's sunny there. Unsettling.",
                "Scout reporting. {zone} is busy. And dry. Weird.",
                "Over {zone}. They can't see us. We brought our own weather.",
                "Recon complete. Detailed notes, with footnotes.",
            ],
            "unique": [
                "Floatplanes up off Crater Lake. Smooth as glass.",
                "Floatplane flight lifting off. The ducks are unimpressed.",
                "Floatplanes rebasing. Any lake, any river. Good luck.",
                "Splashdown on the river. Parked where no bomb will look.",
                "They hit the airbase. We were on the lake. Have a nice day.",
            ],
        },

        // ------------------------------------------------------------------
        // Front Range Free State (Colorado): the Mountain sees everything.
        // ------------------------------------------------------------------
        "FrontRange": {
            "launch": [
                "Front Range flight, wheels up. Thin air, thick skin.",
                "Airborne. Fuel smells like pale ale. Normal.",
                "Lifting off. Mile high and climbing.",
                "Wheels up. Bluebird sky. First chair.",
                "Launching. Mountains on the left, war on the right.",
            ],
            "engage": [
                "Bandits! The Mountain saw them first. Of course.",
                "{enemy} fighters below us. Everyone's below us.",
                "Contact over {zone}. Dropping in.",
                "Tally {enemy}. They're breathing hard up here.",
                "Merging. Send it.",
            ],
            "splash": [
                "Splash one! Total yard sale!",
                "Got him. Good chute. Ski patrol's on the way.",
                "Splash one {enemy}. Altitude wins again.",
                "Target down. That's a black diamond for them.",
                "Splash! Cheers to that.",
            ],
            "flak": [
                "Flak! Avalanche risk just went way up.",
                "Air defense active. Tucking into the valley.",
                "Taking fire! Like moguls, but explosive.",
                "Guns below. Hugging the ridgeline.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Walk it off.",
                "Took some damage. Just a scratch. A big scratch.",
                "Hit, but still flying. Hydrate and push on.",
                "Damage to the tail. Holding altitude. It's what we do.",
            ],
            "ejected": [
                "Punching out! Good chute. Great view of the Rockies.",
                "Squadron down. Four chutes. Somebody call ski patrol.",
                "Ejecting! Landing near a trailhead. I'll hike out.",
                "We're out. Good chutes. Pan says bring snacks.",
                "Good chutes, all four. Soft landing in fresh powder.",
            ],
            "strike": [
                "Bombs on {node}. Sent it.",
                "Direct hit on {node}. Bluebird day for us. Not for them.",
                "{node} struck. Clean line, no falls.",
                "Payload away. That's a summit.",
                "Strike on {node}. Griffin saw it coming. Griffin sees everything.",
            ],
            "miss": [
                "Missed. Crosswind off the peaks.",
                "Bombs wide. We'll take another lap.",
                "Light damage. Tough crowd down there.",
            ],
            "rtb": [
                "Heading home. Back into the Mountain.",
                "Returning to base. The pass is clear, for once.",
                "Heading home. Topping off at the brewery.",
            ],
            "capture": [
                "{node} is ours. Planting a trail marker.",
                "We hold {node}. Radar's better from here already.",
                "{node} captured. Somebody's already scouting brewery sites.",
            ],
            "jewel_strike": [
                "Hit on {node}! Summit reached!",
                "Crown jewel struck. Griffin called it. He's insufferable.",
                "{node} is burning. That's a fourteener of a hit.",
            ],
            "scout": [
                "Eyes on {zone}. The Mountain already knew, but sure.",
                "Scout reporting. {zone} looks busy from up here.",
                "Over {zone}. Visibility unlimited. Perks of altitude.",
                "Recon complete. Probably selling copies.",
            ],
            "unique": [
                "Watchtower is up. We see everything. Every single thing.",
                "Watchtower here. Bandits marked. First shot is yours.",
                "Watchtower on station. Nothing sneaks past us. Nothing.",
                "Watchtower: contacts painted. Go get them.",
                "Watchtower orbiting. Avalanche risk for them: extreme.",
            ],
        },

        // ------------------------------------------------------------------
        // Republic of Texas (Again): big sky, big planes, long memory.
        // ------------------------------------------------------------------
        "Texas": {
            "launch": [
                "Texas flight, wheels up. Hold my coffee.",
                "Airborne. Big sky, bigger planes.",
                "Lifting off. Fixin' to make some noise.",
                "Wheels up out of Abilene. Long way to anywhere.",
                "Off the ground. Everything's bigger up here too.",
            ],
            "engage": [
                "{enemy} fighters, twelve o'clock. Saddle up.",
                "Bandits inbound. Don't mess with Texas, y'all.",
                "Contact over {zone}. Fixin' to tangle.",
                "Tally {enemy}. They picked the wrong state.",
                "Merge! Ride 'em hard!",
            ],
            "splash": [
                "Splash one! Yeehaw!",
                "Got him. Good chute. Enjoy the long walk home.",
                "Splash one {enemy}. That's how we do it down here.",
                "Target down. Somebody ring the dinner bell.",
                "Splash! Put that on the scoreboard.",
            ],
            "flak": [
                "Flak! Like a hailstorm over Amarillo.",
                "Air defense up! Keep it tight!",
                "Tracers! Hold steady. This is nothing.",
                "Taking fire. Big plane, big target, big deal.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Takes more than that.",
                "Took a round. Barely felt it.",
                "Damage on the right side. Still a Texan, still flying.",
                "Hit hard, still flying. We build 'em sturdy.",
            ],
            "ejected": [
                "Punching out! Good chute. Long way down, big sky.",
                "Squadron down. Four chutes. Somebody bring the truck.",
                "Ejecting! Landed in a pasture. Cows are staring.",
                "We're out! All good chutes! Tell Coach we're sorry.",
                "Good chute. Long walk to the nearest barbecue.",
            ],
            "strike": [
                "Bombs on {node}. Remember the Alamo!",
                "Direct hit on {node}. Texas-sized.",
                "{node} hit. That'll leave a mark.",
                "Payload delivered. Y'all have a nice night.",
                "Strike on {node}. Told 'em not to mess with Texas.",
            ],
            "miss": [
                "Missed. Wind's blowing like West Texas.",
                "Bombs long. Overthrew the receiver.",
                "Light damage. We'll be back. We always come back.",
            ],
            "rtb": [
                "Heading home. Save us some brisket.",
                "Returning to base. Long drive, good company.",
                "Bringing it home. Leave the porch light on.",
            ],
            "capture": [
                "{node} is ours. Raising the Lone Star.",
                "We hold {node}. Putting up a fence.",
                "{node} captured. Somebody fire up the smoker.",
            ],
            "jewel_strike": [
                "Hit on {node}! Touchdown, Texas!",
                "Crown jewel struck. Everything's bigger. Including that crater.",
                "{node} is burning. Remember that next time.",
            ],
            "scout": [
                "Eyes on {zone}. Lot of nothing. Some something.",
                "Scout reporting. {zone}'s busier than a state fair.",
                "Over {zone}. Seen bigger, honestly.",
                "Recon complete. Coach'll want the film.",
            ],
            "unique": [
                "The Longhorn is airborne. Clear the sky. It needs most of it.",
                "Longhorn rolling. Runway's long enough. Barely.",
                "Longhorn on target. Everybody else, cover your ears.",
                "Longhorn inbound. Size of a strip mall, hits like a stampede.",
                "Longhorn, bombs away. That's the whole herd.",
            ],
        },

        // ------------------------------------------------------------------
        // Dreamland Syndicate (Nevada): casino money and a saucer.
        // ------------------------------------------------------------------
        "Dreamland": {
            "launch": [
                "Dreamland flight, wheels up. Cards are dealt.",
                "Airborne out of Tonopah. Officially, we were never here.",
                "Lifting off. Feeling lucky.",
                "Off the strip. The other strip.",
                "Wheels up. House rules apply.",
            ],
            "engage": [
                "{enemy} fighters, two o'clock. Let's see their hand.",
                "Bandits inbound. Raising.",
                "Contact over {zone}. Odds look good.",
                "Tally {enemy}. Nice of them to come to the table.",
                "Merging. Double down.",
            ],
            "splash": [
                "Splash one. House wins.",
                "Got him. Good chute. Thanks for playing.",
                "Splash one {enemy}. Cash that chip.",
                "Target down. Winner, winner.",
                "Splash! Ring the bells!",
            ],
            "flak": [
                "Flak! These odds just got worse.",
                "Air defense up. Playing it close.",
                "Tracers everywhere. Like the Strip, but angrier.",
                "Heavy fire! Folding left!",
            ],
            "hit_taken": [
                "I'm hit. Still in the game.",
                "Took some damage. Bad beat. Still standing.",
                "Hit! Still flying. Don't tell the pit boss.",
                "Damage taken. Down, not busted.",
            ],
            "ejected": [
                "Punching out! Good chute. Cashing out.",
                "Squadron down. Four chutes. House doesn't always win.",
                "Ejecting! Landing in the desert. Nobody saw anything.",
                "We're out. Good chutes. Somebody comp us a buffet.",
                "Busted. Floating down under four nice chutes.",
            ],
            "strike": [
                "Bombs on {node}. Pays three to one.",
                "Direct hit on {node}. Jackpot.",
                "{node} hit. The house thanks you for your business.",
                "Payload delivered. All in.",
                "Strike on {node}. Lights out for them, neon on for us.",
            ],
            "miss": [
                "Missed. That's what we get for splitting tens.",
                "Bombs wide. Bad roll.",
                "Light damage. It's a push.",
            ],
            "rtb": [
                "Heading home. The lights are on for us.",
                "Returning to base. Save us a seat at the table.",
                "Cashing out. Back to Vegas.",
            ],
            "capture": [
                "{node} is ours. Putting in some slot machines.",
                "We hold {node}. Under new management.",
                "{node} captured. Opening a lounge.",
            ],
            "jewel_strike": [
                "Hit on {node}! Jackpot, jackpot, jackpot!",
                "Crown jewel struck. That one pays big.",
                "{node} is burning. We called it. We had money on it.",
            ],
            "scout": [
                "Eyes on {zone}. Counting cards. I mean planes.",
                "Scout reporting. {zone}'s sitting on a big stack.",
                "Over {zone}. I can see their hand.",
                "Recon complete. Odds updated.",
            ],
            "unique": [
                "The Prototype is airborne. Don't ask.",
                "Prototype on target. Nobody saw it. Nobody ever does.",
                "Prototype here. Systems are humming. Is it supposed to hum?",
                "Prototype strike delivered. Returning to... huh. Where'd it go?",
                "Prototype off the scope. Ours too. That's normal. Probably.",
            ],
        },

        // ------------------------------------------------------------------
        // Grain Belt Union (North Dakota to Oklahoma): flat, fed, far-seeing.
        // ------------------------------------------------------------------
        "GrainBelt": {
            "launch": [
                "Grain Belt flight, wheels up. Long, flat runway.",
                "Airborne. Can see three states from here.",
                "Lifting off. Moon's up over the wheat.",
                "Wheels up out of Minot. Cold, clear, ready.",
                "Off we go. Checked the weather twice.",
            ],
            "engage": [
                "Bandits! Saw 'em coming an hour ago.",
                "{enemy} fighters, two o'clock. Nowhere to hide out here.",
                "Contact over {zone}. Ope, here they come.",
                "Tally {enemy}. Let's bring in the harvest.",
                "Merging. Hold the line like a shelterbelt.",
            ],
            "splash": [
                "Splash one. Harvested.",
                "Got him. Good chute. Landing in a cornfield.",
                "Splash one {enemy}. Should've stayed home for supper.",
                "Target down. That's one for the county fair.",
                "Splash! Bushel and a peck!",
            ],
            "flak": [
                "Flak! Twister weather up here.",
                "Air defense up. Staying low over the wheat.",
                "Taking fire! Like hail on a tin roof.",
                "Heavy flak. Holding course. Fields don't plow themselves.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Farm equipment's taken worse.",
                "Took a hit. She's still running. Like the old tractor.",
                "Damage on the wing. Baling wire'll hold it.",
                "Hit! Still up. Ope. Sorry. Still up.",
            ],
            "ejected": [
                "Punching out! Good chute. Landing in somebody's soybeans.",
                "Squadron down. Four chutes. Somebody bring the pickup.",
                "Ejecting! Soft landing in a hay field.",
                "We're out. Good chutes. A neighbor's already waving.",
                "All four chutes open. Long walk to the grain elevator.",
            ],
            "strike": [
                "Bombs on {node}. Plowed under.",
                "Direct hit on {node}. Bumper crop.",
                "{node} hit. Harvest's in.",
                "Payload delivered. Tilled it right up.",
                "Strike on {node}. Hope they've got crop insurance.",
            ],
            "miss": [
                "Missed. Crosswind. Always a crosswind.",
                "Bombs wide. Bad soil for it.",
                "Light damage. Lean harvest tonight.",
            ],
            "rtb": [
                "Heading home. Supper's on.",
                "Returning to base. Following the grain elevators.",
                "Bringing it home. Long flat drive. Good night.",
            ],
            "capture": [
                "{node} is ours. Plant something.",
                "We hold {node}. Putting up a silo.",
                "{node} captured. Looks like good soil.",
            ],
            "jewel_strike": [
                "Hit on {node}! That'll make the county paper.",
                "Crown jewel struck. Bumper crop of Bragging Rights.",
                "{node} is burning. Ope. Sorry. Not sorry.",
            ],
            "scout": [
                "Eyes on {zone}. So many hills. Who needs that many?",
                "Scout reporting. {zone}'s got planes parked like combines.",
                "Over {zone}. Seeing it all. Flat-country eyes.",
                "Recon complete. Their forecast: rough.",
            ],
            "unique": [
                "Crop Dusters in. Laying smoke. Good luck aiming now.",
                "Dusters over the target. Smoke's thick as river fog.",
                "Crop Duster flight, low and slow. Smoke's down.",
                "Dusters away. Nobody's bombing straight through this.",
                "Smoke laid. Same pass we'd make over the wheat.",
            ],
        },

        // ------------------------------------------------------------------
        // Beehive Cooperative (Utah): polite, early, industrious.
        // ------------------------------------------------------------------
        "Beehive": {
            "launch": [
                "Beehive flight, wheels up. Five minutes early, as usual.",
                "Airborne. Oh my heck, look at the stars over the salt flats.",
                "Lifting off. Industry! It's the state motto.",
                "Wheels up. Minivan's gassed. Jets too.",
                "Off the ground. Sorry for the noise, neighbors!",
            ],
            "engage": [
                "{enemy} fighters, two o'clock. Oh my heck.",
                "Bandits! Well, they started it. We'll finish it. Politely.",
                "Contact over {zone}. Taking the first shot. Sorry!",
                "Tally {enemy}. Fetch, there's a lot of them.",
                "Merging. Flip, here we go!",
            ],
            "splash": [
                "Splash one! Oh my heck!",
                "Got him. Good chute. Sending a casserole.",
                "Splash one {enemy}. Gosh, sorry about that.",
                "Target down. Thank you for your cooperation.",
                "Splash! That's a thank-you casserole for sure.",
            ],
            "flak": [
                "Flak! Oh my flip!",
                "Air defense up. Staying calm. Staying sweet.",
                "Tracers everywhere! Fetch, fetch, fetch!",
                "Taking fire. Like hail at a family reunion.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Darn it.",
                "Took some damage. We're fine! Totally fine!",
                "Hit! Still up. Fetch, that stings.",
                "Damage on the wing. Wiggling, not breaking.",
            ],
            "ejected": [
                "Punching out! Good chute. The Great Salt Lake floats you right up.",
                "Squadron down. Four chutes. Somebody bring the minivan.",
                "Ejecting! Good chute. Oh my heck, what a view of the arches.",
                "We're out. Everyone's okay! Save us some scones.",
                "Good chutes, all four. We'll be home early. We always are.",
            ],
            "strike": [
                "Bombs on {node}. You hit us first. Remember that.",
                "Direct hit on {node}. Industry!",
                "{node} hit. Oh my heck, that was a big one.",
                "Payload delivered, with a thank-you note.",
                "Strike on {node}. Sorry! Not really. A little.",
            ],
            "miss": [
                "Missed. Oh, fetch.",
                "Bombs wide. Flip. We'll try again.",
                "Light damage. That's okay. We'll be earlier next time.",
            ],
            "rtb": [
                "Heading home. Scones and honey butter on the counter.",
                "Returning to base. Back before ten, like always.",
                "Bringing it home. Follow the Great Salt Lake. You can smell it.",
            ],
            "capture": [
                "{node} is ours. We brought a casserole.",
                "We hold {node}. Cleanup crew's already on it.",
                "{node} captured. It's a beehive now. Very industrious.",
            ],
            "jewel_strike": [
                "Hit on {node}! Oh my heck! Oh my HECK!",
                "Crown jewel struck. You did start it, you know.",
                "{node} is burning. We'll send a get-well casserole.",
            ],
            "scout": [
                "Eyes on {zone}. Lots of activity. Gosh.",
                "Scout reporting. {zone}'s busy. Not Utah busy, but busy.",
                "Over {zone}. Taking very neat notes.",
                "Recon complete. Report's color-coded and early.",
            ],
            "unique": [
                "Seagull Squadron up! Yes, our state bird is the California gull.",
                "Seagulls on the bombers. They'll eat anything.",
                "Seagull Squadron on the drones. Like fries at a picnic.",
                "Gulls are up. Fast, cheap and very, very hungry.",
                "Seagulls over the lake! Bombers, scatter!",
            ],
        },
    },

    aces: {
        "Pacific": AceDef(
            callsign: "PIVOT",
            launch: [
                "Let's circle back on that radar site.",
                "PIVOT online. Keeping my options open.",
                "PIVOT airborne. Started as a fighter. We'll see how I finish.",
            ],
            kill: [
                "PIVOT, splash one. Disrupted, then deprecated.",
                "Fighter, bomber, whatever. Still won. PIVOT out.",
                "That bandit just got pivoted.",
            ],
            duel: [
                "Another ace? Great. Let's whiteboard this.",
                "You're good. I'm in a different market segment.",
                "Love the competition. Now please exit the market.",
            ],
            downed: [
                "PIVOT punching out! This is a strategic exit!",
                "Good chute. For the record, this was a soft landing by design.",
            ],
            returns: [
                "PIVOT is back and has notes.",
                "PIVOT here. Rebuilt, rebranded and very, very annoyed.",
            ],
        ),
        "Cascadia": AceDef(
            callsign: "SASQUATCH",
            launch: [
                "Footprints on the runway. SASQUATCH is up.",
                "Unconfirmed contact, departing the treeline.",
                "SASQUATCH is airborne. Probably. You'll never know.",
            ],
            kill: [
                "Splash one. Composting the wreckage.",
                "Unconfirmed contact. Confirmed splash.",
                "You never saw me. Nobody ever does.",
            ],
            duel: [
                "Another ace. Blurry photos only, please.",
                "You're on my tail? Prove it.",
                "People have hunted me for years. Get in line.",
            ],
            downed: [
                "SASQUATCH is out! Good chute. Witnesses will be unreliable.",
                "Ejecting into the woods. Do not follow me.",
            ],
            returns: [
                "New sightings reported. SASQUATCH is back, and holds grudges.",
                "Big footprints by the hangar. Yeah. I'm back.",
            ],
        ),
        "FrontRange": AceDef(
            callsign: "SWITCHBACK",
            launch: [
                "Bandits at 14,000 feet. For us, that's ground level.",
                "SWITCHBACK airborne. Thin air, short temper.",
                "SWITCHBACK climbing. See you at the summit.",
            ],
            kill: [
                "SWITCHBACK, splash one. You can't outclimb a local.",
                "Splash. Good chute. Enjoy the hike out.",
                "Got him. Took the long way around and still beat him.",
            ],
            duel: [
                "An ace, huh? This trail only goes up.",
                "Let's see you hold this turn at altitude.",
                "Two aces, one ridge. Only one comes off it flying.",
            ],
            downed: [
                "SWITCHBACK ejecting! Fine! I wanted to hike today anyway!",
                "Good chute. This goes in the trail log, and it's not flattering.",
            ],
            returns: [
                "SWITCHBACK is back. Acclimated and annoyed.",
                "Took the long way home. SWITCHBACK is up, and holding a grudge.",
            ],
        ),
        "Texas": AceDef(
            callsign: "BRISKET",
            launch: [
                "BRISKET, wheels up. Low and slow is for cooking.",
                "BRISKET airborne. Been smokin' since dawn.",
                "BRISKET up. Somebody's about to get served.",
            ],
            kill: [
                "Y'all are a long way from home.",
                "BRISKET, splash one. Fell right off the bone.",
                "Splash. Good chute. Tell your folks BRISKET says howdy.",
            ],
            duel: [
                "An ace? Well, saddle up.",
                "This town ain't big enough. And this is Texas.",
                "Twelve hours on the smoker for this moment.",
            ],
            downed: [
                "BRISKET's out! Good chute! This is a dang outrage!",
                "Ejected into a pasture. The cows are judging me.",
            ],
            returns: [
                "BRISKET is back. Rested, sliced and fired up.",
                "BRISKET's back, and Texas remembers.",
            ],
        ),
        "Dreamland": AceDef(
            callsign: "JACKPOT",
            launch: [
                "What happens in this airspace stays in this airspace.",
                "JACKPOT airborne. Let it ride.",
                "JACKPOT up. I'm running hot tonight.",
            ],
            kill: [
                "JACKPOT, splash one. Pay the man.",
                "Splash. Seven, seven, seven.",
                "Got him. Good chute. Your table's closed.",
            ],
            duel: [
                "Another ace? High-stakes table it is.",
                "I'll see your ace and raise you mine.",
                "Let's find out who's holding the better hand.",
            ],
            downed: [
                "JACKPOT busted! Good chute! This table is rigged!",
                "Ejecting. The house will hear about this.",
            ],
            returns: [
                "JACKPOT is back. Double or nothing.",
                "JACKPOT's back at the table, and buying in big.",
            ],
        ),
        "GrainBelt": AceDef(
            callsign: "HARVEST MOON",
            launch: [
                "Knee-high by July, wheels-up by dawn.",
                "HARVEST MOON rising.",
                "HARVEST MOON airborne. Big, bright and right behind you.",
            ],
            kill: [
                "HARVEST MOON, splash one. Bringing in the harvest.",
                "Splash. Good chute. Come back when the corn's taller.",
                "Got him. You could see that one from three states.",
            ],
            duel: [
                "Another ace. Nowhere to hide out here. For either of us.",
                "Saw you coming an hour ago. I've been waiting.",
                "Let's settle this like a county fair. Winner gets the ribbon.",
            ],
            downed: [
                "HARVEST MOON ejecting! Good chute! This is a crop failure!",
                "Out of the jet. Landing in a cornfield. The corn doesn't care.",
            ],
            returns: [
                "HARVEST MOON is back. Second planting.",
                "HARVEST MOON's up again. Waxing, and real sore about it.",
            ],
        ),
        "Beehive": AceDef(
            callsign: "LIME JELLO",
            launch: [
                "LIME JELLO airborne. Wiggles, doesn't break.",
                "LIME JELLO up. Shredded carrots optional.",
                "LIME JELLO, wheels up. Set overnight and ready to go.",
            ],
            kill: [
                "LIME JELLO, splash one. Oh my heck!",
                "Splash. Good chute. Casserole's on its way.",
                "Got him. Wiggled right past his guns.",
            ],
            duel: [
                "Another ace? Fine. I'm firmer than I look.",
                "You can shake me. You can't break me.",
                "Ace on ace. Let's keep it clean. Mostly.",
            ],
            downed: [
                "LIME JELLO punching out! Good chute! Oh, FETCH!",
                "Ejecting. I wiggled! I did not break! The plane did!",
            ],
            returns: [
                "LIME JELLO is back. Set overnight. Firmer than ever.",
                "LIME JELLO's back, and I brought a casserole. A revenge casserole.",
            ],
        ),
    },

    leaders: {
        "Pacific": LeaderDef(
            name: "Princess Donut",
            title: "Founder & Chief Princess Officer",
            bio: "A regal chocolate-and-tan founder in a very small tiara. Princess Donut ships fast, fixes nothing and expects a status update by sunrise.",
            pick: [
                "Princess Donut, live and in production. Let's disrupt the West.",
                "Per my last bark: we're winning this. Ship it.",
            ],
            dawn: [
                "Good morning, team. Quick sync: we win today. Okay, bye.",
                "New day, new patch. I haven't read the notes. Neither should you.",
                "Let's circle back on last night. Actually, let's not. Ship it.",
                "Reminder: my calendar is blocked for a nap from two to five. Win before then.",
                "Love the energy, everyone. Big learnings. Bigger drones.",
            ],
            winning: [
                "Up and to the right, darlings. Hockey stick.",
                "We're crushing it. Someone get me a treat. A premium one.",
                "Our numbers are incredible. I'd like a bigger tiara.",
            ],
            losing: [
                "It's not a loss. It's a pivot.",
                "Okay, so we're pre-revenue on Bragging Rights. Temporarily.",
                "Let's take this offline and win it later.",
            ],
            our_jewel_hit: [
                "The Server Farm?! I'm putting this in my status update. In red.",
                "Excuse me. That was my favorite building. I'm drafting a very strong email.",
                "Rude. Drones are on scheduled maintenance. I am on scheduled outrage.",
            ],
            victory: [
                "We won. Of course we did. Somebody ship me a bigger tiara.",
                "Bragging Rights acquired. Thank you all for the learnings. Mostly mine.",
            ],
            defeat: [
                "Congrats to the winner. We'll be back with version two.",
                "Fine. We lost. But we lost fast, and that's culture.",
            ],
        ),
        "Cascadia": LeaderDef(
            name: "Ranger Huckleberry",
            title: "Chief Ranger",
            bio: "A big shaggy Newfoundland in a ranger hat and rain slicker who has seen it all, mostly through drizzle. He runs the Commonwealth like a national park: stay on the trail, pack out your trash, and please don't feed the bombers.",
            pick: [
                "Ranger Huckleberry. Welcome to the Commonwealth. Please stay on the trail.",
                "Oh. We're doing a war. Okay. Let me get my slicker.",
            ],
            dawn: [
                "Morning. Forecast is rain. Tomorrow's forecast is also rain.",
                "Reminder: pack it in, pack it out. That includes bombs.",
                "I've reviewed last night. I have concerns. I always have concerns.",
                "Please don't feed the bears. Or the bombers.",
                "Sunbreak expected around noon. Don't get used to it.",
            ],
            winning: [
                "We're ahead. Let's not make a big thing of it.",
                "Things are going well. I'm suspicious, but well.",
                "Good work, everyone. I'll allow one cheer. Quietly.",
            ],
            losing: [
                "We're behind. Happens on every hike. Keep walking.",
                "Not great. Let's regroup at the trailhead.",
                "I've seen worse. Mostly at campsites.",
            ],
            our_jewel_hit: [
                "They hit the dam. The salmon are filing a complaint. So am I.",
                "Grand Coulee. Really. Somebody's getting a sternly worded citation.",
                "That dam powers everything. I'm writing a very long incident report.",
            ],
            victory: [
                "We won. Leave no trace. Except the trophy. Keep the trophy.",
                "Victory. I'd celebrate outside, but it's raining. I'll celebrate inside.",
            ],
            defeat: [
                "Congratulations to the winner. Please drive slowly through the park on your way out.",
                "Well. The forest will remember. The forest is very patient.",
            ],
        ),
        "FrontRange": LeaderDef(
            name: "Griffin & Pan",
            title: "Co-Commanders (Brothers)",
            bio: "Brothers who run the Free State from deep inside Cheyenne Mountain. Griffin, a speckled cattle dog, watches every blip on the radar; Pan, a big black lab-shepherd mix, watches the snack drawer.",
            pick: [
                "Griffin: Front Range, reporting! I've already checked the radar. Twice. | Pan: Is there a snack bowl in this bunker?",
                "Griffin: We see everything from up here. | Pan: I see a nap.",
            ],
            dawn: [
                "Griffin: Avalanche risk: high. Bomber risk: higher. | Pan: Breakfast risk: zero. I checked.",
                "Griffin: I've been up since four watching radar. | Pan: I've been up since now.",
                "Griffin: Big day. Huge. Did everyone hydrate? | Pan: I hydrated. Then I napped.",
                "Griffin: Radar's clear. Mostly. Probably. Let me look again. | Pan: He's going to look again.",
                "Griffin: Bluebird day! Perfect visibility! Perfect! | Pan: Too loud. Too early.",
            ],
            winning: [
                "Griffin: We're winning! I predicted this! | Pan: He predicts everything. Eventually.",
                "Pan: We're ahead? Treats? | Griffin: After the war. | Pan: Treats now.",
                "Griffin: Every blip on the board is going our way. | Pan: Nice. Wake me for the parade.",
            ],
            losing: [
                "Griffin: We're behind. I told you. I told everyone. | Pan: You did. Very loudly.",
                "Pan: It's fine. | Griffin: It is NOT fine. | Pan: It's a little fine.",
                "Griffin: I need a better radar picture of this situation. | Pan: Have you tried lying down?",
            ],
            our_jewel_hit: [
                "Griffin: They sealed the Mountain! Our radar's dark! | Pan: We're locked in with the snack drawer? Okay.",
                "Pan: Was that a knock? | Griffin: That was a bomb on Cheyenne Mountain! | Pan: Rude. We're napping.",
                "Griffin: The Mountain is sealed, not broken. Sealed! | Pan: So nobody's coming in. Good. More couch.",
            ],
            victory: [
                "Griffin: We won! I saw it coming three nights ago! | Pan: He did. I saw a sandwich.",
                "Pan: Victory nap? | Griffin: Victory nap. | Pan: Best brother.",
            ],
            defeat: [
                "Griffin: Well played, everyone. I had a radar picture of this. | Pan: Good game. Who's got the chips?",
                "Pan: We lost? | Griffin: We lost. | Pan: Still got each other. And snacks.",
            ],
        ),
        "Texas": LeaderDef(
            name: "Coach Tank",
            title: "Head Coach",
            bio: "A Blue Lacy in a ball cap, with a whistle he blows at everything, including the weather. Coach Tank runs the Republic like two-a-day practice: hustle, hydrate, and nobody touches his clipboard.",
            pick: [
                "Coach Tank. Alright, team, huddle up. We play for Texas.",
                "Listen up, son. This is a big state. We're gonna need big plays.",
            ],
            dawn: [
                "Rise and shine! Two-a-days start now!",
                "Film review: we looked good, we looked sloppy, we looked Texan.",
                "Hustle out there. Nobody's guarding the house unless you do.",
                "Tonight we remember. We always remember.",
                "Hydrate! I don't care if it's a war. Hydrate.",
            ],
            winning: [
                "That's what I'm talking about! Hustle pays!",
                "We're up on the board. Don't get comfortable. Win by more.",
                "Look at that scoreboard. Big state, big lead.",
            ],
            losing: [
                "We're down. That's fine. Texas plays best from behind.",
                "Shake it off. Second half, son.",
                "We're getting outhustled. Not anymore. Not on my field.",
            ],
            our_jewel_hit: [
                "They hit the Refinery? Oh, we remember that. We remember everything.",
                "Somebody hit the Gulf Refinery. Write that name down. Twice.",
                "Flag on the play! That's our refinery!",
            ],
            victory: [
                "We won! Somebody dump the water cooler on me. I've earned it.",
                "Bragging Rights belong to Texas. Like they always should've.",
            ],
            defeat: [
                "Good game, everybody. Handshake line. Firm grip.",
                "We lost. Happens. Next season, we remember.",
            ],
        ),
        "Dreamland": LeaderDef(
            name: "Lucky",
            title: "Pit Boss",
            bio: "A pug in a dealer's visor and bow tie who has never lost a bet he'd admit to. Lucky runs the Syndicate from a neon back room where everything has odds and nobody asks about the saucer.",
            pick: [
                "Lucky, Pit Boss. Welcome to the table. House rules.",
                "Pull up a chair, friend. The odds just got interesting.",
            ],
            dawn: [
                "Morning, high rollers. The lights stayed on. Good sign.",
                "New night, new odds. I like ours.",
                "Place your bets. I already placed mine.",
                "Reminder: the house always wins. We're the house.",
                "Saucer's fueled. Don't ask with what.",
            ],
            winning: [
                "The house is up. As is tradition.",
                "We're ahead. Let it ride.",
                "Look at that stack. Somebody bring me a fresh visor.",
            ],
            losing: [
                "We're down. Variance. It happens.",
                "Bad run. The cards'll turn.",
                "Even the house has a cold night. One night.",
            ],
            our_jewel_hit: [
                "The dam? THE DAM? Somebody's banned from the Strip for life.",
                "Hoover Dam hit. The Strip goes dark. My mood goes darker.",
                "Lights out on the Strip. Somebody's paying for that. With interest.",
            ],
            victory: [
                "The house wins. It always wins. Thank you for playing.",
                "Bragging Rights paid out. Collect them at the cage.",
            ],
            defeat: [
                "Good game. Even the house loses one. Never two.",
                "Tonight, you beat the house. Enjoy it. Tell nobody.",
            ],
        ),
        "GrainBelt": LeaderDef(
            name: "Agent Sorghum",
            title: "County Extension Agent",
            bio: "A corgi in a seed cap who knows the frost dates of every county from Fargo to Oklahoma City. Agent Sorghum runs the Union like a soil test: patient, thorough, and quietly certain theirs is the real Ball of Twine.",
            pick: [
                "Agent Sorghum, County Extension. Let's see what this soil can grow.",
                "Afternoon. Good to see you. Plant early, defend often.",
            ],
            dawn: [
                "Morning. Frost overnight, war continues. Check your tires.",
                "Soil's good, sky's clear, silos are full. Let's work.",
                "Reminder: the Harvest Shipment is up. Let 'em bid.",
                "Forecast: flat, windy, and visible from everywhere. As usual.",
                "The Ball of Twine is safe. Please keep it that way.",
            ],
            winning: [
                "We're ahead. Good season. Don't get greedy.",
                "Bumper crop of Bragging Rights. Let's store it right.",
                "That's what patience and good dirt will do.",
            ],
            losing: [
                "Lean season. We plan for those.",
                "We're behind. Rotate the crops, try again.",
                "Not our year yet. There's always next planting.",
            ],
            our_jewel_hit: [
                "Somebody hit the Ball of Twine. Oh, you're going to regret that.",
                "The Twine. The actual Twine. Revenge strike is already gassed up.",
                "They hit the Ball of Twine. It's strategically worthless. It's also ours.",
            ],
            victory: [
                "We won. Feed the West, take the Bragging Rights. Good harvest.",
                "Victory. I'd like everyone to stay for pie.",
            ],
            defeat: [
