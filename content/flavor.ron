// Flyover Country: flavor text.
// Radio chatter, ace lines, dog-leader lines, advisor warnings, newspaper
// headlines and curtain filler. Loaded at startup; edit freely, no recompile.
//
// Tone check for every line: played straight, punch at places (never people),
// nobody dies on screen (planes "splash", pilots get a good chute), every
// faction lovable. The dog leaders are never in danger. Chatter stays short:
// under 70 characters where possible, never over 90.
//
// Griffin & Pan lines are mini-dialogues: "Speaker: text | Speaker: text".
//
// Placeholders
//   chatter:   {node} place name, {enemy} enemy faction short name, {zone} state name
//   advisor:   {unit} {count} {node} {nodes} {pct} {resource} {jewel} {reason}
//              ({reason} is a lowercase predicate, e.g. "crosses 2 air defense sites
//              with no jammer", so lines read "The route {reason}." or "It {reason}.")
//   headlines: {attacker} {victim} {node} {ace} {count} {zone}
//              Headlines are written in caps; uppercase the substituted names too.
FlavorDef(
    chatter: {
        // ------------------------------------------------------------------
        // Pacific Venture Republic (California): startup nation, ships fast.
        // ------------------------------------------------------------------
        "Pacific": {
            "launch": [
                "Wheels up. Let's ship it.",
                "Pacific flight is live in production.",
                "Off the deck. Burn rate's high, morale's higher.",
                "Departing the Bay. Fog's thick, vibes are good.",
                "Airborne. Smoother than the freeway, honestly.",
                "Wheels up. This sprint ends over enemy territory.",
                "Airborne. Out-of-office is on. Back after the raid.",
            ],
            "engage": [
                "{enemy} fighters, two o'clock. Let's disrupt them.",
                "Bandits inbound. Taking this meeting.",
                "Contact! {enemy} jets closing fast. Turning in.",
                "Hostiles over {zone}. Time to scale this up.",
                "Going hot. This is the part of the demo that works.",
                "{enemy} jets inbound. They did not book time on my calendar.",
                "Contact over {zone}. Moving them to the blocked column.",
            ],
            "splash": [
                "Splash one. That's a learning for them.",
                "Got him! Good chute. Disrupted.",
                "Splash! Somebody update the leaderboard.",
                "Target down. Closing that ticket.",
                "Splash one {enemy}. Tell the Princess we hit our numbers.",
                "Splash one. Churned. Good chute, though.",
                "Splash one {enemy}. Their retention is trending down.",
            ],
            "flak": [
                "Flak! Heavy flak! This was not on the roadmap.",
                "Air defense is up. Jinking hard.",
                "Tracers everywhere. Love the energy, hate the bullets.",
                "Guns below! Pulling up into the marine layer.",
                "Flak! This is a lot of unsolicited feedback.",
                "Ground fire! Worse than the 405 at five.",
            ],
            "hit_taken": [
                "I'm hit! Still flying. Logging it as a known issue.",
                "Took a round in the wing. Patching it live.",
                "Damage on the left side. Still in beta, still flying.",
                "Hit, but stable. We ship with bugs.",
                "I'm hit! Filing a P1 ticket. Still flying.",
                "Took damage. Rolling back to last stable altitude.",
            ],
            "ejected": [
                "Punching out! Good chute. Great view of the coast.",
                "Four good chutes. We're sunsetting this squadron.",
                "Ejecting! Somebody save my seat at the standup.",
                "Squadron down. All chutes open. We'll pivot.",
                "Out of the jet and floating. Honestly? Kind of a vibe.",
                "Punching out! Good chute. Landing near a nice kombucha place.",
                "Four good chutes. Can somebody expense four rides home?",
            ],
            "strike": [
                "Bombs away on {node}. Shipped.",
                "Direct hit on {node}. Massive impact. Huge.",
                "{node} is disrupted. Repeat, disrupted.",
                "Payload delivered. Five stars, would bomb again.",
                "Strike on {node} complete. Adding it to the changelog.",
                "Bombs on {node}. Pushed straight to main.",
                "{node} hit. Delivered ahead of the roadmap, for once.",
            ],
            "miss": [
                "Missed. Let's call it a learning.",
                "Bombs long. We'll iterate.",
                "Minimal impact. Calling it a soft launch.",
                "Missed. Works on my machine, though.",
                "Bombs wide. Closing that one as won't fix.",
            ],
            "rtb": [
                "Heading home. Save us some fish tacos.",
                "Returning to base. Retro over burritos?",
                "Wrapping up. Back to the garage.",
                "Returning to base. Somebody put the cold brew on.",
                "Heading home up the coast. No traffic at ten thousand feet.",
            ],
            "capture": [
                "{node} is ours. Acquired, not merged.",
                "We hold {node}. Planting a flag and a coworking space.",
                "{node} captured. Rebranding it at dawn.",
                "{node} is ours. Already raising a seed round there.",
                "We hold {node}. Every new hire gets a hoodie.",
            ],
            "jewel_strike": [
                "Hit on {node}! That's our whole quarter, right there.",
                "Crown jewel struck! Somebody screenshot that.",
                "{node} is burning. Disruption achieved.",
                "Hit on {node}! Ring the gong! Ring every gong!",
                "{node} struck. Putting that in the pitch deck. Slide one.",
            ],
            "scout": [
                "Eyes on {zone}. Lots going on. Sending the deck.",
                "Scout here. {zone} is busier than the pitch said.",
                "Mapping {zone} the old way. No satellites. Wild.",
                "Recon done. Data's fresh, takes are hot.",
                "Over {zone}. Total addressable market looks huge.",
                "Scouting {zone}. Grabbing screenshots for the all-hands.",
            ],
            "unique": [
                "Unicorn Swarm launched. They don't come back. That's the model.",
                "Drones away. Weak alone, scary at scale.",
                "Swarm on target. Each drone costs less than a Palo Alto lunch.",
                "Swarm inbound. All of them. At once. On purpose.",
                "One-way drones away. Tonight's patch says they mostly avoid the ocean.",
                "Drones launched. Tonight's patch notes: we'll find out together.",
                "Unicorn Swarm away. A thousand tiny MVPs, all shipping at once.",
            ],
            "bounce": [
                "Bombs on {node} bounced. {enemy} has a fence. A really good fence.",
                "Payload rejected by the {enemy} fence. Filing a bug report.",
                "We hit {node} and it went BOING. That was not in the spec.",
            ],
            "park": [
                "Ground crew status: in a hammock. Blockers: none.",
                "Pond's great. Somebody tell the Princess there's no Wi-Fi.",
                "Team-building tonight: agility tunnels. Engineering's winning.",
            ],
            "fetch": [
                "Big Fetch launched. Payload count: one. Payload size: yes.",
                "Ball's in production. ETA to {node}: imminent.",
                "Tracking the ball to {node}. Fuzz levels nominal.",
            ],
        },

        // ------------------------------------------------------------------
        // Cascadian Commonwealth (Washington, Oregon): rain, firs, process.
        // ------------------------------------------------------------------
        "Cascadia": {
            "launch": [
                "Cascade flight, wheels up. It's raining. Obviously.",
                "Lifting off. Visibility low. Concern also low.",
                "Off the runway. Wipers on, coffee in hand.",
                "Departing. Ceiling's at 200 feet. Feels like home.",
                "Airborne. Leaving the clouds only because we have to.",
                "Lifting off. The mountain is out tonight. Nobody panic.",
                "Wheels up. Signed the trail register on the way out.",
            ],
            "engage": [
                "{enemy} fighters in our clouds. Rude.",
                "Contact, low. They came in through the overcast. Turning in.",
                "Bandits over {zone}. Time for some Northwest hospitality.",
                "Tally {enemy}. Sun-dried and overconfident.",
                "Engaging. Stay on the trail. The trail is behind them.",
                "{enemy} fighters, no permit. Issuing a citation.",
                "Bandits over {zone}. They're off-trail. Escorting them out.",
            ],
            "splash": [
                "Splash one. Leave no trace. Well. Some trace.",
                "Splash! Good chute into the ferns.",
                "Got one. The next ferry will pick him up.",
                "Target down. That's what the rain is for.",
                "Splash one {enemy}. Wreckage goes in the recycling.",
                "Splash one. Good chute into the salal. He'll be fine. Damp.",
                "Splash one {enemy}. Welcome to the Northwest. Bring a jacket.",
            ],
            "flak": [
                "Flak! Can't see a thing. Hope they can't either.",
                "Tracers through the drizzle. Pressing on.",
                "Air defense is up. Dropping into the cloud deck.",
                "Heavy fire! Like a hailstorm, but personal.",
                "Flak! That's a burn ban violation, people!",
                "Ground fire! Brighter than our last sunny day.",
            ],
            "hit_taken": [
                "I'm hit. Still flying. Moss will grow over it.",
                "Took some damage. We're fine. Damp, but fine.",
                "Hit in the tail. Treating it like a slow leak.",
                "Damage taken. Still airworthy. Mostly.",
                "Hit. We're okay. Patching it with duct tape and patience.",
                "Took a round. Logging it in triplicate. Still flying.",
            ],
            "ejected": [
                "Ejecting! Good chute. Landing in the Douglas firs.",
                "We're out. Four chutes. It's raining up here too.",
                "Squadron down. Everyone's okay. Somebody bring towels.",
                "Punching out. Good chute. Beautiful hike back.",
                "Good chutes into the lake. Huckleberry's already swimming out.",
                "Punching out! Good chute. Landing by a banana slug. Hi, buddy.",
                "Four good chutes. Find us in the huckleberry bushes. Snacking.",
            ],
            "strike": [
                "Bombs on {node}. Under cloud cover, as nature intended.",
                "Direct hit on {node}. Filing a very thorough report.",
                "{node} hit. Sustainably.",
                "Payload delivered. Pack it in, pack it out.",
                "Strike on {node} confirmed. Heading back into the gray.",
                "Bombs on {node}. After a lot of discussion, very decisive.",
                "{node} hit. Under budget, behind schedule, very wet.",
            ],
            "miss": [
                "Missed. Too cloudy. Even for us.",
                "Bombs wide. We'll open a comment period on that.",
                "Light damage only. We'll be back. It'll still be raining.",
                "Missed. Rain on the bombsight. Somebody bring a squeegee.",
                "Bombs wide. Our goggles fogged. They always fog.",
            ],
            "rtb": [
                "Heading home. Following the rain.",
                "Returning to base. Somebody put the kettle on.",
                "Back up the Gorge. Long night, good night.",
                "Heading home. Wet runway, dry socks waiting.",
                "Returning to base. Huckleberry pie at the ranger station.",
            ],
            "capture": [
                "{node} is ours. Planting a tree.",
                "We hold {node}. First order of business: recycling.",
                "{node} captured, after extensive community input.",
                "{node} is ours. Installing bike racks and a rain garden.",
                "We hold {node}. Trail signs going up. Please stay on them.",
            ],
            "jewel_strike": [
                "Hit on {node}! Now that felt deeply satisfying.",
                "Crown jewel struck. That's for every sunny day you bragged about.",
                "{node} hit. Let's not gloat. Okay, one small gloat.",
                "Hit on {node}! Huckleberry is going to be so quietly proud.",
                "{node} struck. Somebody log it. In ink. Waterproof ink.",
            ],
            "scout": [
                "Eyes on {zone}. It's sunny there. Unsettling.",
                "Scout reporting. {zone} is busy. And dry. Weird.",
                "Over {zone}. They can't see us. We brought our own weather.",
                "Recon complete. Detailed notes, with footnotes.",
                "Over {zone}. Visibility unlimited. I hate it. I'm squinting.",
                "Scouting {zone}. Lots of planes. Not one decent rain jacket.",
            ],
            "unique": [
                "Floatplanes up off Crater Lake. Smooth as glass.",
                "Floatplane flight lifting off. The ducks are unimpressed.",
                "Floatplanes rebasing. Any lake, any river. Good luck.",
                "Splashdown on the river. Parked where no bomb will look.",
                "They hit the airbase. We were on the lake. Have a nice day.",
                "Floatplanes up off the Sound. The orcas gave us a nod.",
                "Floatplanes away. Our runway is wherever it's wet. So: everywhere.",
            ],
            "bounce": [
                "Bombs bounced off {node}. {enemy}'s at the park. Fair enough.",
                "Strike came right back up through the clouds. Never seen that before.",
                "Park's closed. {enemy} fence held. Respecting the closure.",
            ],
            "park": [
                "Ranger's in the pond. He's not coming out. We've stopped asking.",
                "Crew's doing a jigsaw puzzle. It's all trees. Perfect.",
                "Dry night at the park. We're unsettled. Enjoying it, but unsettled.",
            ],
            "fetch": [
                "Ball's above the clouds. First sun it's seen. Bound for {node}.",
                "Big Fetch away. Heavy, damp and headed for {node}.",
                "Launcher's clear. Please stand back from the ball. All of it.",
            ],
        },

        // ------------------------------------------------------------------
