            "jewel_strike": [
                "Hit on {node}! Summit reached!",
                "Crown jewel struck. Griffin called it. He's insufferable.",
                "{node} is burning. That's a fourteener of a hit.",
                "Hit on {node}! First descent! Somebody film it!",
                "{node} struck. Pan wants to know if they had snacks there.",
            ],
            "scout": [
                "Eyes on {zone}. The Mountain already knew, but sure.",
                "Scout reporting. {zone} looks busy from up here.",
                "Over {zone}. Visibility unlimited. Perks of altitude.",
                "Recon complete. Probably selling copies.",
                "Over {zone}. Griffin's gonna want this twice. Then again.",
                "Scouting {zone}. It's so flat. Where do they ski?",
