    headlines: {
        "first": [
            "War breaks out across the West; dogs reportedly very good",
            "Seven flags go up over the West this morning",
            "The West goes to war, but everyone's being pretty nice about it",
            "Sky over the Big Empty gets busy for the first time in years",
            "First night of the war; nobody sleeps, except one dog in Denver",
            "It begins. Planes over the West, coffee on in every kitchen",
        ],
        "strike": [
            "{attacker} hits {victim}'s {site}",
            "{site} takes a hit; {victim} blames {attacker}",
