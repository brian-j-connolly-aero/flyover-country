        "Cascadia": LeaderDef(
            name: "Ranger Huckleberry",
            title: "Chief Ranger",
            bio: "A big shaggy Newfoundland in a ranger hat and rain slicker who has seen it all, mostly through drizzle. He runs the Commonwealth like a national park: stay on the trail, pack out your trash, and please don't feed the bombers.",
            pick: [
                "Ranger Huckleberry. Welcome to the Commonwealth. Please stay on the trail.",
                "Oh. We're doing a war. Okay. Let me get my slicker.",
            ],
            dawn: [
                "Morning. Forecast is rain. Tomorrow's forecast is also rain.",
                "Reminder: pack it in, pack it out. That includes bombs.",
                "I've reviewed last night. I have concerns. I always have concerns.",
                "Please don't feed the bears. Or the bombers.",
                "Sunbreak expected around noon. Don't get used to it.",
                "Morning. Light rain, then moderate rain, then a brief rain.",
                "Last night's trail log is forty pages. Please read it. I'll wait.",
                "Ferries are running late. So is the war. Coffee's on.",
            ],
            winning: [
                "We're ahead. Let's not make a big thing of it.",
                "Things are going well. I'm suspicious, but well.",
                "Good work, everyone. I'll allow one cheer. Quietly.",
                "We're ahead. I'm logging it, but in pencil. Things change.",
                "Good work, everyone. Boots off at the door, then you may celebrate.",
            ],
            losing: [
                "We're behind. Happens on every hike. Keep walking.",
                "Not great. Let's regroup at the trailhead.",
                "I've seen worse. Mostly at campsites.",
                "We're behind. Stay calm. Panic burns energy. So does uphill.",
                "Moss doesn't rush, and moss covers everything eventually. Be the moss.",
            ],
            our_jewel_hit: [
                "They hit the dam. The salmon are filing a complaint. So am I.",
                "Grand Coulee. Really. Somebody's getting a sternly worded citation.",
                "That dam powers everything. I'm writing a very long incident report.",
            ],
            victory: [
                "We won. Leave no trace. Except the trophy. Keep the trophy.",
                "Victory. I'd celebrate outside, but it's raining. I'll celebrate inside.",
                "We won. I'll allow two cheers. Then everyone please pick up your litter.",
            ],
            defeat: [
                "Congratulations to the winner. Please drive slowly through the park on your way out.",
                "Well. The forest will remember. The forest is very patient.",
                "We lost, fair and square. I'll be at the ranger station if anyone needs a map home.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "We're spending the night at Project Bark Park. The forecast there is dry. I don't trust it.",
                "The committee has voted. Eleven to nothing, one abstention. We're going to the dog park.",
                "The trail's gotten steep, folks. We're stopping at the shelter tonight. The shelter is a dog park.",
            ],
            park_return: [
                "Back from the park. Damp, rested and ready. The pond was lovely, thank you for asking.",
                "Good morning. We've slept, we've swum, and we've loaded a tennis ball the size of a ranger station.",
                "The forest is patient. The forest also has a very large launcher now.",
            ],
            fetch: [
                "Stay on the trail. The ball will not be staying on the trail.",
                "After careful review and a full public comment period: fetch.",
                "This ball passed its environmental review. Barely. Releasing it now.",
            ],
        ),
        "FrontRange": LeaderDef(
            name: "Griffin & Pan",
            title: "Co-Commanders (Brothers)",
            bio: "Brothers who run the Free State from deep inside Cheyenne Mountain. Griffin, a speckled cattle dog, watches every blip on the radar; Pan, a big black lab-shepherd mix, watches the snack drawer.",
            pick: [
                "Griffin: Front Range, reporting! I've already checked the radar. Twice. | Pan: Is there a snack bowl in this bunker?",
                "Griffin: We see everything from up here. | Pan: I see a nap.",
            ],
            dawn: [
                "Griffin: Avalanche risk: high. Bomber risk: higher. | Pan: Breakfast risk: zero. I checked.",
                "Griffin: I've been up since four watching radar. | Pan: I've been up since now.",
                "Griffin: Big day. Huge. Did everyone hydrate? | Pan: I hydrated. Then I napped.",
                "Griffin: Radar's clear. Mostly. Probably. Let me look again. | Pan: He's going to look again.",
                "Griffin: Bluebird day! Perfect visibility! Perfect! | Pan: Too loud. Too early.",
                "Griffin: Radar's quiet. Too quiet. | Pan: I like quiet. Quiet is nap time.",
                "Griffin: I made a color-coded threat chart. | Pan: I made toast. | Griffin: ...Can I have some toast?",
                "Griffin: Pressure's dropping. Storm's coming. | Pan: Storm means couch day. Best day.",
            ],
            winning: [
                "Griffin: We're winning! I predicted this! | Pan: He predicts everything. Eventually.",
                "Pan: We're ahead? Treats? | Griffin: After the war. | Pan: Treats now.",
                "Griffin: Every blip on the board is going our way. | Pan: Nice. Wake me for the parade.",
                "Griffin: We're way ahead. Is that suspicious? | Pan: It's called winning. Relax your ears.",
                "Pan: Told you we'd win. | Griffin: You said 'whatever.' | Pan: Whatever means win.",
            ],
            losing: [
                "Griffin: We're behind. I told you. I told everyone. | Pan: You did. Very loudly.",
                "Pan: It's fine. | Griffin: It is NOT fine. | Pan: It's a little fine.",
                "Griffin: I need a better radar picture of this situation. | Pan: Have you tried lying down?",
                "Griffin: We're behind. I'm making a chart about it. | Pan: Make it a chart of snacks. Cheers everybody up.",
                "Pan: Hey. We're still brothers. | Griffin: That's not a strategy. | Pan: It's a pretty good one.",
            ],
            our_jewel_hit: [
                "Griffin: They sealed the Mountain! Our radar's dark! | Pan: We're locked in with the snack drawer? Okay.",
                "Pan: Was that a knock? | Griffin: That was a bomb on Cheyenne Mountain! | Pan: Rude. We're napping.",
                "Griffin: The Mountain is sealed, not broken. Sealed! | Pan: So nobody's coming in. Good. More couch.",
            ],
            victory: [
                "Griffin: We won! I saw it coming three nights ago! | Pan: He did. I saw a sandwich.",
                "Pan: Victory nap? | Griffin: Victory nap. | Pan: Best brother.",
                "Griffin: We did it! Every blip! Every single blip! | Pan: Proud of you. Now lie down.",
            ],
            defeat: [
                "Griffin: Well played, everyone. I had a radar picture of this. | Pan: Good game. Who's got the chips?",
                "Pan: We lost? | Griffin: We lost. | Pan: Still got each other. And snacks.",
                "Pan: We lost. | Griffin: I should've watched the radar more. | Pan: You watched it plenty. Come here.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "Griffin: Four Corners is basically our backyard. We could walk. | Pan: We are not walking.",
                "Griffin: Strategic retreat to the Bark Park. Radar off for one night. One! | Pan: Best war ever.",
                "Griffin: I packed the radar, a backup radar and a map of the fence. | Pan: I packed a sandwich. We're even.",
            ],
            park_return: [
                "Griffin: We're back! Rested! I only checked the radar six times! | Pan: He slept on it. Like, on top of it.",
                "Griffin: Fresh squadrons on the line, Big Fetch loaded. | Pan: I'm also loaded. With hot dogs.",
                "Griffin: I feel amazing. Do you feel amazing? | Pan: I feel ready for second breakfast.",
            ],
            fetch: [
                "Griffin: Wind check, arc check, altitude check. Launching! | Pan: Can I go get it after?",
                "Griffin: The Mountain saw this coming. The Mountain threw it. | Pan: Ball! BALL! BALL!",
                "Griffin: One shot. Make it count. | Pan: One. Counted. Snack?",
            ],
        ),
        "Texas": LeaderDef(
            name: "Coach Tank",
            title: "Head Coach",
            bio: "A Blue Lacy in a ball cap, with a whistle he blows at everything, including the weather. Coach Tank runs the Republic like two-a-day practice: hustle, hydrate, and nobody touches his clipboard.",
            pick: [
                "Coach Tank. Alright, team, huddle up. We play for Texas.",
                "Listen up, son. This is a big state. We're gonna need big plays.",
            ],
            dawn: [
                "Rise and shine! Two-a-days start now!",
                "Film review: we looked good, we looked sloppy, we looked Texan.",
                "Hustle out there. Nobody's guarding the house unless you do.",
                "Tonight we remember. We always remember.",
                "Hydrate! I don't care if it's a war. Hydrate.",
                "Morning, team. Laps first, then breakfast. Then the war.",
                "I watched last night's film four times. We got work to do, son.",
                "Big game tonight. Every night's a big game. That's Texas.",
            ],
            winning: [
                "That's what I'm talking about! Hustle pays!",
                "We're up on the board. Don't get comfortable. Win by more.",
                "Look at that scoreboard. Big state, big lead.",
                "We're up big. Don't you dare take a knee yet.",
                "Look at that. That's a championship scoreboard, son.",
            ],
            losing: [
                "We're down. That's fine. Texas plays best from behind.",
                "Shake it off. Second half, son.",
                "We're getting outhustled. Not anymore. Not on my field.",
                "We're behind. Good. Now we find out who wants it more.",
                "Down a few. I've seen this team come back from worse. Last week, in fact.",
            ],
            our_jewel_hit: [
                "They hit the Refinery? Oh, we remember that. We remember everything.",
                "Somebody hit the Gulf Refinery. Write that name down. Twice.",
                "Flag on the play! That's our refinery!",
            ],
            victory: [
                "We won! Somebody dump the water cooler on me. I've earned it.",
                "Bragging Rights belong to Texas. Like they always should've.",
                "We won! Champions of the whole West! Laps are cancelled tomorrow!",
            ],
            defeat: [
                "Good game, everybody. Handshake line. Firm grip.",
                "We lost. Happens. Next season, we remember.",
                "We lost. Hold your heads up. Then go run some laps.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "Halftime, son. We're taking it at the Bark Park. Hydrate, stretch, and think about what you did.",
                "Every great team gets a bye week. Ours is one night long and has a pond.",
                "We're not running. We're going to the locker room. The locker room has agility tunnels.",
            ],
            park_return: [
                "Second half, son. Fresh legs, full tank, and a trick play the size of a stadium.",
                "I gave a halftime speech at the pond last night. The ducks enlisted. Let's go.",
                "Back on the field. Remember the Alamo. Also remember the Bark Park. It was real nice.",
            ],
            fetch: [
                "Hut, hut... FETCH!",
                "Fake punt! Real ball! Real, real big ball!",
                "Go long! Longer! Keep going, son! LONGER!",
            ],
        ),
        "Dreamland": LeaderDef(
            name: "Lucky",
            title: "Pit Boss",
            bio: "A pug in a dealer's visor and bow tie who has never lost a bet he'd admit to. Lucky runs the Syndicate from a neon back room where everything has odds and nobody asks about the saucer.",
            pick: [
                "Lucky, Pit Boss. Welcome to the table. House rules.",
                "Pull up a chair, friend. The odds just got interesting.",
            ],
            dawn: [
                "Morning, high rollers. The lights stayed on. Good sign.",
                "New night, new odds. I like ours.",
                "Place your bets. I already placed mine.",
                "Reminder: the house always wins. We're the house.",
                "Saucer's fueled. Don't ask with what.",
                "Morning. Coffee's free. The odds aren't. Let's work.",
                "Last night's numbers came in. The house is pleased. Mostly.",
                "The saucer? What saucer? Moving on. Morning, everybody.",
            ],
            winning: [
                "The house is up. As is tradition.",
                "We're ahead. Let it ride.",
                "Look at that stack. Somebody bring me a fresh visor.",
                "We're up. Comp everybody a shrimp cocktail.",
                "Hot streak. Nobody touch anything. Nobody change seats.",
            ],
            losing: [
                "We're down. Variance. It happens.",
                "Bad run. The cards'll turn.",
                "Even the house has a cold night. One night.",
                "We're down. Happens. Change dealers, change luck.",
                "Cold table tonight. Doesn't matter. The house plays long.",
            ],
            our_jewel_hit: [
                "The dam? THE DAM? Somebody's banned from the Strip for life.",
                "Hoover Dam hit. The Strip goes dark. My mood goes darker.",
                "Lights out on the Strip. Somebody's paying for that. With interest.",
            ],
            victory: [
                "The house wins. It always wins. Thank you for playing.",
                "Bragging Rights paid out. Collect them at the cage.",
                "Game over. House wins. Free buffet for everyone, losers included. I'm generous.",
            ],
            defeat: [
                "Good game. Even the house loses one. Never two.",
                "Tonight, you beat the house. Enjoy it. Tell nobody.",
                "You beat the house, fair and square. I'll be checking the cameras anyway.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "Tables are closed tonight. The house is on its break. Fifteen minutes. Okay, twelve hours.",
                "When the shoe runs cold, a smart player takes a walk. I'm walking to a dog park.",
                "We're coloring up for the night. Back at dawn with a fresh stack and a little surprise.",
            ],
            park_return: [
                "The house is open. Fresh stack, rested dealers, and one very large chip to play.",
                "Shuffle up and deal, friends. We're back, and we brought a ball.",
                "Good morning, high rollers. Remember that little surprise I mentioned? It's round. And not little.",
            ],
            fetch: [
                "All in. The ball is the whole stack.",
                "The ball is in the air. No more bets.",
                "Every pit boss gets one big hand a game. This is mine.",
            ],
        ),
        "GrainBelt": LeaderDef(
            name: "Agent Sorghum",
            title: "County Extension Agent",
            bio: "A corgi in a seed cap who knows the frost dates of every county from Fargo to Oklahoma City. Agent Sorghum runs the Union like a soil test: patient, thorough, and quietly certain theirs is the real Ball of Twine.",
            pick: [
                "Agent Sorghum, County Extension. Let's see what this soil can grow.",
                "Afternoon. Good to see you. Plant early, defend often.",
            ],
            dawn: [
                "Morning. Frost overnight, war continues. Check your tires.",
                "Soil's good, sky's clear, silos are full. Let's work.",
                "Reminder: the Harvest Shipment is up. Let 'em bid.",
                "Forecast: flat, windy, and visible from everywhere. As usual.",
                "The Ball of Twine is safe. Please keep it that way.",
                "Morning. Dew point's good, wind's steady, nobody's touched the Twine. Fine start.",
                "Got a quarter inch overnight. The beans are happy. I'm cautiously happy.",
                "The farmers have been up since four. Pilots, you can be up too.",
            ],
            winning: [
                "We're ahead. Good season. Don't get greedy.",
                "Bumper crop of Bragging Rights. Let's store it right.",
                "That's what patience and good dirt will do.",
                "We're ahead. Don't count your bushels till they're in the bin.",
                "Good season so far. Feels like a soft rain right before harvest.",
            ],
            losing: [
                "Lean season. We plan for those.",
                "We're behind. Rotate the crops, try again.",
                "Not our year yet. There's always next planting.",
                "We're behind. Dry years end. They always do.",
                "Hail took the top off our season. The roots are fine.",
            ],
            our_jewel_hit: [
                "Somebody hit the Ball of Twine. Oh, you're going to regret that.",
                "The Twine. The actual Twine. Revenge strike is already gassed up.",
                "They hit the Ball of Twine. It's strategically worthless. It's also ours.",
            ],
            victory: [
                "We won. Feed the West, take the Bragging Rights. Good harvest.",
                "Victory. I'd like everyone to stay for pie.",
                "We won. Pie's at the grange hall. All of it. Every flavor.",
            ],
            defeat: [
                "Good game. Lean year. We'll be back with better seed.",
                "Congratulations. Come by anytime. We'll still feed you.",
                "We lost. That's farming. Some years the weather wins. Next year's seed is already ordered.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "Even good fields lie fallow. We'll lie fallow at the Bark Park. Just the one night.",
                "Folks, we're taking a rain day. It isn't raining. We're taking it anyway.",
                "Heading to Four Corners. Pond's full, grass is green and somebody packed a cooler.",
            ],
            park_return: [
                "Fresh crews, full silos, and one seed the size of a grain elevator. Let's plant it.",
                "We're back. Good rest does for a crew what good rain does for a field.",
                "Morning. Soil test came back: ready. Big Fetch is loaded. Let's work.",
            ],
            fetch: [
                "Wind's out of the west at ten knots. Perfect for throwing things. Launch.",
                "This one's going in the almanac. Fetch!",
                "Broadcast seeding, one seed. Big one. Let 'er fly.",
            ],
        ),
        "Beehive": LeaderDef(
            name: "Biscuit",
            title: "Chief Volunteer",
            bio: "A golden retriever in a crisp white short-sleeved shirt, a tie and a volunteer name tag. Biscuit is always early, extremely polite, and never shows up anywhere without a casserole.",
            pick: [
                "Hi! I'm Biscuit. Oh my heck, thank you for picking Utah!",
                "Biscuit, Chief Volunteer. We'll be early, we'll be polite, and we'll be ready.",
            ],
            dawn: [
                "Good morning! I've been up since five. Scones are on the counter.",
                "Reminder: we don't start fights. We just finish them. Politely.",
                "Forecast: the Greatest Snow on Earth up high, red rock down low. Lovely day for it.",
                "Who needs help today? Our fighters can guard anybody's stuff.",
                "Industry, everyone! It's on the flag for a reason.",
                "Good morning! I made a sign-up sheet for tonight. Spots are filling fast!",
                "Fresh snow on the peaks and fresh cinnamon rolls on the counter. What a day!",
                "I already shoveled our walk and three neighbors'. Let's get to work!",
            ],
            winning: [
                "We're ahead! Oh my heck! Thank you, everyone!",
                "Look at us go. Busy bees, busy bees.",
                "We're winning. Let's be gracious about it. Then win more.",
                "We're ahead! Let's send thank-you notes to everyone. Even the ones we bombed.",
                "Oh my heck, look at that scoreboard. I'm wagging. I can't stop wagging.",
            ],
            losing: [
                "We're behind. Oh, fetch. That's okay. We'll work harder.",
                "Not our best night. Let's make a casserole and regroup.",
                "Flip. Okay. Big families don't quit. We just get a bigger minivan.",
                "We're behind. That's okay! Helmets on. We'll pedal harder.",
                "Flip. Not our night. Let's get some ice cream and talk it through.",
            ],
            our_jewel_hit: [
                "Somebody hit the Fry Sauce Reserve. Oh my heck. Oh my HECK.",
                "The fry sauce? Really? That is so, so not okay. Fetch!",
                "They hit the Reserve. I'm not angry. I'm writing a very polite, very firm letter.",
            ],
            victory: [
                "We won! Thank you so much! Everybody gets a casserole!",
                "Bragging Rights to Utah. Oh my heck. I need to sit. Good sit.",
                "We won! Oh my heck! Green Jell-O for everyone! The good kind, with pineapple!",
            ],
            defeat: [
                "Congratulations! You earned it. Please take some scones for the drive.",
                "Good game, everybody! We'll get you next time. Politely.",
                "Good game! I'll bring the winner a plate of cookies. Store-bought, sorry. Busy week.",
            ],
            // Project Bark Park: heading out, coming back, and the Big Fetch.
            retreat: [
                "We're going to the Bark Park tonight! I made a sign-up sheet for the potluck. Casseroles go on line one.",
                "It's only a short drive to Four Corners! We'll be there early. We'll put out the folding chairs.",
                "Sorry, neighbors, the Cooperative is closed tonight! Please leave a note on the fence. A nice note.",
            ],
            park_return: [
                "Good morning! We're back, we're rested, and there are scones for everybody. Also a ball. A big one.",
                "Oh my heck, what a night! Fresh squadrons, a full pantry, and one great big ball.",
                "We're home a whole hour early. Everyone's rested, and the launcher is all loaded. Industry!",
            ],
            fetch: [
                "Fetch! Oh my heck. FETCH!",
                "Sorry! In advance! So sorry! Launching!",
                "Ball away! I mean, bombs away! I mean... oh my heck, just look at it go!",
            ],
        ),
    },

    advisor: {
        // Princess Donut: startup chief of staff energy, a little sassy.
        "Pacific": {
            "fuel_short": [
                "Love the ambition, but the fuel doesn't love us back. {count} of tonight's flights will stay home.",
                "Quick flag: we're out of runway. Literally. {count} of these flights won't get fuel.",
            ],
            "red_route": [
                "Love the energy. {unit} is flying red, though. The route {reason}.",
                "{unit} on that route? Bold. Too bold. It {reason}.",
            ],
            "no_escort": [
                "Love the energy. Zero escorts for {unit} is a choice, though.",
                "{unit} is going in solo and enemy fighters are out there. Let's not make that a learning.",
            ],
            "empty_sky": [
                "Nobody is guarding the capital. Who's watching the garage, darlings?",
                "Our capital has zero fighters over it. That's not lean, that's empty.",
            ],
            "jewel_open": [
                "{jewel} has no guard and it's Gloves Off. Please protect my favorite building.",
                "It's Gloves Off and {jewel} is wide open. That's a single point of failure, team.",
            ],
            "idle": [
                "{count} of our squadrons will just sit there tonight. We don't pay them to nap. I nap.",
                "Per my last bark: {count} of our squadrons could be flying right now. Ship them.",
            ],
            "supply_cap": [
                "Our Supply is almost at the cap. Spend it. Hoarding is so last quarter.",
                "We're sitting on a pile of Supply. Build something before it overflows.",
            ],
            "weak_spot": [
                "Quick flag: {pct}% of our {resource} runs through {nodes}. Single point of failure.",
                "If anyone hits {nodes}, we lose {pct}% of our {resource}. Let's not.",
            ],
            "no_scout": [
                "No scouts up tonight. We're shipping blind, darlings.",
                "Zero scouts? We need data, team. Vibes are not data.",
            ],
            "repair": [
                "{node} is damaged. Let's patch it before it becomes a whole thing.",
                "{node} is still smoking. Can we put some Supply on that?",
            ],
            "all_good": [
                "Honestly? This plan is great. Ship it.",
                "No notes. I hate saying that. Ship it.",
            ],
            "special": [
                "Read tonight's Patch Notes before you launch drones. Or don't. I never do.",
                "Drones are half price. Buy in bulk. That's the whole strategy.",
                "Drones don't come home, darlings. Plan like they're already gone.",
            ],
            "doghouse": [
                "We're in the doghouse, darlings. Pivot: tonight we can retreat to Project Bark Park. Squadrons rest, our land can't be touched, and tomorrow we're back with the Big Fetch. Once per game.",
                "Option on the table: Project Bark Park. One night off, squadrons home, our land untouchable. Tomorrow: fresh squadrons plus the Big Fetch. One use per game. Ship it?",
            ],
            "retreating": [
                "Offsite confirmed. Everyone's at the Bark Park, nothing flies tonight, and out-of-office replies are on.",
                "Done. We're dark until sunrise. No flights, no standups, just the pond.",
            ],
            "fetch_ready": [
                "The Big Fetch is loaded. Pick any target we could hit tonight in the Faction tab. One shot. Make it a launch people talk about.",
                "Reminder: the Big Fetch is ready. Faction tab, any target we're allowed to attack tonight. One shot only, so no rollbacks.",
            ],
        },
        // Ranger Huckleberry: tired, deadpan park ranger.
        "Cascadia": {
            "fuel_short": [
                "We can't fuel everything tonight. {count} of these flights will stay home. Sorry.",
                "Fuel's low. {count} of tonight's flights will have to sit this one out.",
            ],
            "red_route": [
                "{unit} is heading into a red zone. Please don't. The route {reason}.",
                "I've pulled hikers off routes like this. {unit} is on one. It {reason}.",
            ],
            "no_escort": [
                "Bear country rule: never hike alone. {unit} has no escort, and enemy fighters are around.",
                "{unit} is going out alone with enemy fighters nearby. Wear a bell, at least.",
            ],
            "empty_sky": [
                "Nobody's guarding the capital. That's how you get raccoons. And bombers.",
                "Our capital has no fighters over it. I'd put somebody up there.",
            ],
            "jewel_open": [
                "It's Gloves Off and {jewel} has no guard. Please guard the dam.",
                "{jewel} is wide open and anyone can hit it now. I'm begging you. Mildly.",
            ],
            "idle": [
                "{count} of our squadrons will spend tonight in the hangar. Fine by me, but still.",
                "{count} of our squadrons could be out there tonight. Just saying.",
            ],
            "supply_cap": [
                "Our Supply is almost at the cap. Spend some before it spills over.",
                "Supply's piling up near the limit. Spend some. Our builds take a while, remember.",
            ],
            "weak_spot": [
                "Lose {nodes} and we lose {pct}% of our {resource}. Keep an eye on that.",
                "{pct}% of our {resource} goes through {nodes}. That's a lot of eggs in one basket.",
            ],
            "no_scout": [
                "No scouts out. We're hiking in the dark without a headlamp.",
                "Nobody's scouting tonight. We can't see much. Even less than usual.",
            ],
            "repair": [
                "{node} is damaged. I'd fix that before moss grows on it.",
                "{node} needs repairs. Put some Supply on it, please.",
            ],
            "all_good": [
                "No problems I can see. And I look for problems.",
                "Plan looks sound. Stay on the trail.",
            ],
            "special": [
                "Overcast tonight. Enemy strikes in our airspace lose their aim. Use it.",
                "New squadrons need a community input period. Order now; they arrive a night late, but sharp.",
                "Remember, new builds show up a night late. Plan two nights ahead. I always do.",
            ],
            "doghouse": [
                "We're well behind. Tonight we may retreat to Project Bark Park. Squadrons rest at home, our land can't be touched, and tomorrow we return fresh with the Big Fetch. Once per game.",
                "A suggestion: one night at Project Bark Park. Squadrons stay home, nobody can touch our land, and we come back with fresh squadrons and the Big Fetch. We only get this once.",
            ],
            "retreating": [
                "Retreat is set. Everyone's at the park tonight, so nothing flies. Somebody bring the good thermos.",
                "Confirmed. All hands at the Bark Park. No flights tonight. Bring a towel. Bring two.",
            ],
            "fetch_ready": [
                "The Big Fetch is loaded. In the Faction tab, choose any target we could legally strike tonight. One shot. Choose carefully.",
                "Big Fetch is ready. Open the Faction tab and pick any target we're allowed to attack tonight. We only get the one.",
            ],
        },
        // Griffin & Pan: Griffin frets and watches radar, Pan wants a snack.
        "FrontRange": {
            "fuel_short": [
