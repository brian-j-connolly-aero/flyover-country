// Version 2 rules. Chances are per mille. Distances are map units.
RulesDef(
    nights: 8,
    // Targets open in stages: Airfields and prizes from Night 1,
    // Factories from `open_factories`, HQs and Crown Jewels from `open_hqs`.
    open_factories: 3,
    open_hqs: 6,
    stage_names: ("Saber Rattling", "Open Season", "Gloves Off"),
    // A night is `ticks` long; raids launch at `launch_tick` and fly `speed` units a tick.
    ticks: 200, launch_tick: 4, speed: 6,
    start_supply: 6, max_squadrons: 6, planes: 3, big_bomber_planes: 4,
    costs: Costs(fighter: 4, bomber: 5, repair: 2, move_fast: 3),
    health: Health(hq: 4, factory: 3, airfield: 3, jewel: 3),
    // Dawn income: HQ standing, Factory health + factory_base, each prize.
    income: Income(hq: 1, factory_base: 0, prize: 1),
    combat: Combat(
        rounds: 2, hit: 500, ace_hit: 650,
        flak_hit: 400, flak_shots: 1, hq_flak_shots: 2,
        bomb_hit: 550, crop_duster_hit: 700,
    ),
    patrol: Patrol(radius: 75, mountain_radius: 105),
    score: Score(pip: 2, big_pip: 3, plane: 1, prize: 1),
    bark_park: BarkPark(
        first_night: 3, last_night: 7, gap: 10, low_squadrons: 1,
        supply: 6, squadrons: 4, fetch_pips: 2, fetch_tick: 150,
    ),
)
