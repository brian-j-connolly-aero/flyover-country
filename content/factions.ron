// The seven factions. Each breaks exactly one rule (signature), has a
// double-edged quirk, one unique unit, a crown jewel and a named ace.
// Every faction is led by a dog. The dogs are never in any danger.
[
    FactionDef(
        id: Pacific,
        name: "Pacific Venture Republic", short: "California", home: "California",
        color: "#FF5FA2", shape: "circle",
        emblem: "A sun wearing a beta badge",
        leader: "Princess Donut",
        plays_like: "Swarm cheaply, gamble on updates",
        ace: "PIVOT", unique: Drone, jewel: "pac_jewel",
        card: RulesCard(
            signature: ("Move Fast", "Drone squadrons cost half price. Drones are one-way: they attack and never come home."),
            quirk: ("Patch Notes", "Each dawn a random public patch tweaks all drones. Half are buffs, half are nerfs, all are announced on the big screen."),
            unique: ("Unicorn Swarm", "Cheap one-way drones. Weak alone, scary in numbers: every extra swarm on the same target hits harder."),
            jewel: ("The Last Server Farm", "If hit, no drones launch the next night (scheduled maintenance)."),
            ace: ("PIVOT", "Strikes as well as any bomber, and if nothing shows up by midnight, switches role mid-mission to hit a nearby military target."),
        ),
    ),
    FactionDef(
        id: Cascadia,
        name: "Cascadian Commonwealth", short: "Cascadia", home: "Washington and Oregon",
        color: "#3DDC84", shape: "triangle",
        emblem: "A fir tree under a rain cloud",
        leader: "Ranger Huckleberry",
        plays_like: "Hide in the clouds, strike from lakes",
        ace: "SASQUATCH", unique: Floatplane, jewel: "cas_jewel",
        card: RulesCard(
            signature: ("Eternal Overcast", "Enemy strikes inside Cascadian airspace lose accuracy, and enemy scouts see only half of what's there."),
            quirk: ("Process", "New squadrons need a community input period. They arrive a night late, but arrive as veterans."),
            unique: ("Floatplanes", "Light strike planes that can base on any lake, so strikes rarely catch them parked."),
            jewel: ("Grand Coulee Dam", "If hit, factories run at half power for two nights."),
            ace: ("SASQUATCH", "Never appears on enemy radar or air defense. Enemy chatter only reports an unconfirmed contact."),
        ),
    ),
    FactionDef(
        id: FrontRange,
        name: "Front Range Free State", short: "Colorado", home: "Colorado",
        color: "#4CC9F0", shape: "diamond",
        emblem: "A radar dish on a snowy peak",
        leader: "Griffin & Pan",
        plays_like: "See everything, sell secrets",
        ace: "SWITCHBACK", unique: Watchtower, jewel: "frs_jewel",
        card: RulesCard(
            signature: ("The Mountain", "The widest radar picture on the map. Once per night, sell one region's radar picture to another player for Supply."),
            quirk: ("Microbrewed Fuel", "Jet fuel comes from dozens of tiny breweries. Nearly impossible to cripple, but output is capped low."),
            unique: ("Watchtower", "An airborne radar plane that extends vision and gives nearby friendly fighters the first shot."),
            jewel: ("Cheyenne Mountain", "Can't be destroyed, only sealed: a hit blinds Colorado's radar for one night."),
            ace: ("SWITCHBACK", "Always gets the first shot. Bandits at 14,000 feet? For Colorado, that's ground level."),
        ),
    ),
    FactionDef(
        id: Texas,
        name: "Republic of Texas (Again)", short: "Texas", home: "Texas",
        color: "#FF4D4D", shape: "star",
        emblem: "A lone star with longhorns",
        leader: "Coach Tank",
        plays_like: "Huge bombers, longer grudges",
        ace: "BRISKET", unique: Longhorn, jewel: "tex_jewel",
        card: RulesCard(
            signature: ("Remember the Alamo", "Strikes on whoever hit Texas last night cost no Fuel. Hitting Texas once is easy; hitting it twice is expensive."),
            quirk: ("Big Oil, Big Targets", "Texan refineries pump double Fuel, but they're always visible to everyone and take double damage."),
            unique: ("The Longhorn", "One super-heavy bomber, the hardest-hitting unit in the game. If shot down, it takes three nights to rebuild."),
            jewel: ("The Gulf Refinery", "If hit, Fuel income halves for two nights."),
            ace: ("BRISKET", "Fights harder the farther the enemy is from home. Y'all are a long way from home."),
        ),
    ),
    FactionDef(
        id: Dreamland,
        name: "Dreamland Syndicate", short: "Dreamland", home: "Nevada",
        color: "#B388FF", shape: "ring",
        emblem: "A flying saucer shaped like a poker chip",
        leader: "Lucky",
        plays_like: "Bet on everyone else's war",
        ace: "JACKPOT", unique: Prototype, jewel: "drm_jewel",
        card: RulesCard(
            signature: ("The House Always Wins", "During planning, place one secret bet on another player's mission. Payouts are revealed during the show."),
            quirk: ("Grid-Dependent", "The neon Strip earns the most Supply in the game, and all of it runs on Hoover Dam."),
            unique: ("The Prototype", "A stealth saucer, invisible on radar until it attacks. One-in-six chance per mission it simply doesn't come back."),
            jewel: ("Hoover Dam", "If hit, the Strip goes dark: zero Supply next night."),
            ace: ("JACKPOT", "Lucky: the first hit JACKPOT takes each night just... misses."),
        ),
    ),
    FactionDef(
        id: GrainBelt,
        name: "Grain Belt Union", short: "Grain Belt", home: "North Dakota to Oklahoma",
        color: "#F2E86D", shape: "square",
        emblem: "A wheat sheaf crossed with a propeller",
        leader: "Agent Sorghum",
        plays_like: "Feed the West, auction dinner",
        ace: "HARVEST MOON", unique: CropDuster, jewel: "grb_jewel",
        card: RulesCard(
            signature: ("Breadbasket Auction", "Each night the Grain Belt offers one Harvest Shipment. Everyone else bids Supply in secret; the winner gets the shipment and the Grain Belt keeps the bid."),
            quirk: ("Flat as a Pancake", "The whole territory is always visible to everyone. But converted missile silos reach farther and fire more, and the radar sees attackers coming from very far away."),
            unique: ("Crop Dusters", "Slow, cheap planes that lay smoke over a node, cutting enemy strike accuracy there tonight and tomorrow."),
            jewel: ("World's Largest Ball of Twine", "Strategically worthless. Hitting it earns the most Bragging Rights in the game, and the Grain Belt gets a free revenge strike."),
            ace: ("HARVEST MOON", "Guards twice as far out. Knee-high by July, wheels-up by dawn."),
        ),
    ),
    FactionDef(
        id: Beehive,
        name: "Beehive Cooperative", short: "Utah", home: "Utah",
        color: "#FF9F1C", shape: "hexagon",
        emblem: "A beehive with little wings",
        leader: "Biscuit",
        plays_like: "Help the neighbors, never start it",
        ace: "LIME JELLO", unique: Gull, jewel: "bee_jewel",
        card: RulesCard(
            signature: ("Service Project", "Utah fighters may guard anyone's nodes, not just their own. Every shoot-down over a neighbor's land earns a thank-you casserole: Supply and a Bragging Right."),
            quirk: ("Oh My Heck", "Utah never throws the first punch: it can only attack factions that hit Utah first, until Gloves Off. In exchange, Utah's guards always get the first shot when defending a home, theirs or a neighbor's."),
            unique: ("Seagull Squadron", "Cheap, fast interceptors that eat bombers and drones. Utah's state bird is the California gull."),
            jewel: ("Strategic Fry Sauce Reserve", "If hit, Utah's guards lose their first shot for two nights."),
            ace: ("LIME JELLO", "Wiggles but doesn't break: never turns back damaged, and survives one knockout a night."),
        ),
    ),
]
